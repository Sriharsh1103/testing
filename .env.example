# Copy this file to .env.development / .env.stage / .env.prod and fill in real values.
# Never commit .env, .env.development, .env.stage, .env.prod (they are gitignored).

# ==== Environment ====
ENV=development

# ==== Phase 1: Price data provider ====
# Get free key: https://twelvedata.com (signup, no card needed, free tier ~800 requests/day)
# Note: XAU/USD volume from this provider is always 0 (OTC market, no central volume) —
# Phase 2 computes a volatility-based proxy (ATR/range) instead of relying on this field.
TWELVE_DATA_API_KEY=

# ==== Phase 3: News provider ====
# Get free key: https://finnhub.io (signup, no card needed, free tier ~60 calls/min)
FINNHUB_API_KEY=

# ==== Phase 4: Claude decision layer ====
# Get key: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ==== App config ====
SYMBOL=XAU/USD
TIMEFRAME=15min
# Scalping (5min) | Intraday (15min) | Swing (4h) — pick from the Home dashboard,
# it keeps TIMEFRAME in sync automatically
TRADE_STYLE=Intraday
# how often the scheduler (app/scheduler/runner.py) ticks
POLL_INTERVAL_ACTIVE_MIN=5
POLL_INTERVAL_IDLE_MIN=5

# ==== Phase 6 (optional): Notifications ====
# Get from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==== Phase 8 (optional): Risk management — defaults below, no account size used ====
# % of capital to risk per trade
RISK_PER_TRADE_PCT=1.0
# stop-loss distance = this many x ATR
ATR_STOP_MULTIPLIER=2.0
# take-profit distance = stop distance x this ratio (1:1.5 risk:reward)
REWARD_RISK_RATIO=1.5

# ==== Paper-trading ledger (simulated P&L, no real money/orders) ====
PAPER_INITIAL_BALANCE=1000.0
